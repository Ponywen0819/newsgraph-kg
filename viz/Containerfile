FROM docker.io/library/python:3.12-slim
ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1
# fastapi+uvicorn：唯讀視覺化 API；falkordb：直查圖（v1 不需整個 graphiti）
RUN pip install "fastapi[standard]" uvicorn falkordb
WORKDIR /app
COPY app.py .
COPY static ./static
EXPOSE 8088
CMD ["uvicorn", "app:app", "--host", "127.0.0.1", "--port", "8088"]
