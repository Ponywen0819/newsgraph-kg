# 複製本檔為 .env 後填入你自己的金鑰:cp .env.example .env
# .env 已被 .gitignore 忽略,不會進版控。

# === 抽取 LLM:DeepSeek(OpenAI 相容)===
DEEPSEEK_API_KEY=                 # 必填,向 https://platform.deepseek.com 申請
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# === Embedding:NVIDIA NIM(雲端,4096 維)===
NVIDIA_API_KEY=                   # 必填,向 https://build.nvidia.com 申請
NVIDIA_EMBED_MODEL=nvidia/nv-embed-v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_INPUT_TYPE=passage
NVIDIA_TRUNCATE=END
# nv-embed-v1 的輸出維度,必須與 FalkorDB 向量索引一致
EMBEDDING_DIM=4096

# === 存儲:FalkorDB(Redis-based 圖資料庫)===
FALKOR_HOST=127.0.0.1
FALKOR_PORT=6379
FALKOR_DB=news

# === 其他 ===
NEWS_GROUP_ID=news
MAX_COROUTINES=1                  # 序列灌圖(Pi 上避免對 DeepSeek 併發 TLS 出錯);資源足可調高
NEWSGRAPH_API_KEY=                # 自訂一組長字串,api.py 用來驗證 X-API-Key
